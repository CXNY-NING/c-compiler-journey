# ---------- 编译器生成的汇编 ----------
# 注意：编译器输出（Sub_C/out.s、legacy/*/out.s）是产物，不入库；
# 但 tests/expected/ 下的 golden 快照是"测试源码"，必须入库，
# 否则回归测试的基线会丢失（此例外必须排在 *.s 之后才生效）。
*.s
!tests/expected/*.s

# ---------- Office / 编辑器临时文件 ----------
~$*
~WRD*.tmp
~WRL*.tmp

# ---------- 工具数据（非项目内容） ----------
.workbuddy/

# ---------- OS ----------
Thumbs.db
desktop.ini
.DS_Store

# ---------- 本项目专有 ----------
# 01scan 原为独立仓库，已禁用（重命名为 .git_disabled），历史完整保留
.git_disabled/
# 编译出的可执行文件（教程 gcc 产物）
scan
